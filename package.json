{
  "name": "farm-iot-backend",
  "version": "2.0.0",
  "description": "Backend for the Farm IoT project — controls a pump and grow lights and tracks soil moisture for an ESP32/Arduino R4 WiFi controller.",
  "main": "server.js",
  "type": "commonjs",

  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test"
  },

  "engines": {
    "node": ">=18"
  },

  "keywords": [
    "iot",
    "arduino",
    "esp32",
    "farm-automation",
    "smart-irrigation",
    "nodejs-backend"
  ],

  "author": "Velagapudi Dhanvin Raj",
  "license": "MIT",

  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },

  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
