// Copy this file to "arduino_secrets.h" (same folder) and fill in your real
// values there. arduino_secrets.h is listed in .gitignore and will NEVER be
// committed or pushed to GitHub — keep it that way.
//
// After rotating your WiFi password on your router and generating a new
// device token, put the NEW values here, not in the .ino file.

#define SECRET_WIFI_SSID     "your-wifi-name"
#define SECRET_WIFI_PASSWORD "your-wifi-password"

// Must match the DEVICE_TOKEN env var set on your backend host (Railway/Fly).
// Generate a fresh random one, e.g.: openssl rand -hex 16
#define SECRET_DEVICE_TOKEN  "your-new-random-device-token"
